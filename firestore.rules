rules_version = '2';

// ============================================================
//  Aplikasi ini masuk secara ANONIM otomatis (tanpa layar login).
//  Aturan di bawah hanya mensyaratkan "sudah login" (request.auth
//  != null) — dan setiap pengunjung yang membuka halaman ini akan
//  otomatis login anonim. Jadi ini BUKAN mengunci data khusus per
//  orang: semua orang yang berhasil membuka halamannya membaca dan
//  menulis koleksi "hutang" yang sama.
//
//  Manfaatnya: mencegah akses langsung lewat REST API tanpa lewat
//  aplikasi (mis. orang yang hanya tahu projectId dari kode publik,
//  tapi tidak pernah membuka aplikasinya). Tidak mencegah siapa pun
//  yang membuka tautan aplikasinya sendiri.
//
//  Kalau nanti ingin data benar-benar privat per pengguna, ganti ke
//  Firebase Auth yang sesungguhnya (email/Google) dan tambahkan
//  kolom pemilik + pengecekan request.auth.uid == resource.data.uid.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /hutang/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
